<div class="mapmyvisitors-widget" style="margin: 1rem 0; min-height: 260px;">
  {% assign mmv_id = include.d | default: site.mapmyvisitors.d %}
  {% assign mmv_cl = include.cl | default: site.mapmyvisitors.cl | default: 'ffffff' %}
  {% assign mmv_w  = include.w  | default: site.mapmyvisitors.w  | default: 'a' %}
  {% assign dev_preview = include.dev_preview | default: false %}
  {% if mmv_id %}
    <div id="mapmyvisitors-container"></div>
    <script>
      (function () {
        try {
          var host = (window.location && window.location.hostname) || '';
          var isLocal = host === 'localhost' || host === '127.0.0.1' || host === '0.0.0.0';
          var devPreview = '{{ dev_preview }}' === 'true';
          var container = document.getElementById('mapmyvisitors-container');
          if (!container) return;
          if (isLocal && !devPreview) {
            container.innerHTML =
              '<div style="padding: 1rem; border: 1px dashed var(--global-divider-color); border-radius: 8px; color: var(--global-text-color-light);">MapMyVisitors preview is hidden in local development. View on the live site to see the map.</div>';
            return;
          }
          var s = document.createElement('script');
          s.type = 'text/javascript';
          s.async = true;
          s.id = 'mapmyvisitors';
          s.src = '//mapmyvisitors.com/map.js?d={{ mmv_id | escape }}&cl={{ mmv_cl }}&w={{ mmv_w }}';
          container.appendChild(s);
        } catch (e) {
          // no-op
        }
      })();
    </script>
    <noscript>
      <div style="padding: 1rem; border: 1px dashed var(--global-divider-color); border-radius: 8px; color: var(--global-text-color-light);">
        JavaScript is disabled; MapMyVisitors cannot load.
      </div>
    </noscript>
  {% else %}
    <div style="padding: 1rem; border: 1px dashed var(--global-divider-color); border-radius: 8px; color: var(--global-text-color-light);">
      MapMyVisitors is not configured. Add your site key under <code>mapmyvisitors.d</code> in <code>_config.yml</code>.
    </div>
  {% endif %}
</div>
