---
layout: page
---
<div class="post people-page">
  <article>
    {% assign pi_count = page.principal_investigator | size %}
    {% assign postdoc_count = page.current_members.postdoctoralresearcher | size %}
    {% assign grad_count = page.current_members.graduatestudents | size %}
    {% assign undergrad_count = page.current_members.undergraduatestudents | size %}
    {% assign highschool_count = page.current_members.highschoolstudents | size %}
    {% assign current_total = postdoc_count | plus: grad_count | plus: undergrad_count | plus: highschool_count %}

    <div class="people-overview">
      <div>
        <p class="people-kicker">AI & Mobility Research Lab</p>
        <h2>Lab Members</h2>
      </div>
      <div class="people-summary">
        <a href="#grad" class="people-summary-item">
          <span>{{ grad_count }}</span>
          <small>Graduate</small>
        </a>
        <a href="#undergrad" class="people-summary-item">
          <span>{{ undergrad_count }}</span>
          <small>Undergrad</small>
        </a>
        <a href="#highschool" class="people-summary-item">
          <span>{{ highschool_count }}</span>
          <small>High School</small>
        </a>
        <a href="#past" class="people-summary-item">
          <span>{{ page.past_members | size }}</span>
          <small>Alumni</small>
        </a>
      </div>
    </div>

    <div class="people-quicklinks">
      <strong>Jump to:</strong>
      <a href="#pi">PI</a>
      <a href="#postdoc">Postdoc</a>
      <a href="#grad">Graduate</a>
      <a href="#undergrad">Undergraduate</a>
      <a href="#highschool">High School</a>
      <a href="#past">Past Members</a>
    </div>

    {% if page.principal_investigator %}
      <h2 class="section-title" id="pi">
        <span>Principal Investigator</span>
        <small>{{ pi_count }}</small>
      </h2>
      <div class="members-section pi-section">
        {% for profile in page.principal_investigator %}
          <div class="member-profile people-card">
            <div class="profile-container">
              <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
                {% if profile.image %}
                  {% if profile.image contains 'http' %}
                    {% assign profile_image_path = profile.image %}
                  {% else %}
                    {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
                  {% endif %}
                  {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
                  {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3 }}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
                  <div class="profile-image-wrapper">
                    {% include figure.liquid path=profile_image_path class=profile_image_class sizes=sizes alt=profile.name %}
                  </div>
                  <div class="profile-info">
                    {% if profile.name %}
                      <div class="profile-name">{{ profile.name }}</div>
                    {% endif %}
                    {% if profile.role %}
                      <div class="profile-role">{{ profile.role | replace: ', ', ' &middot; ' }}</div>
                    {% endif %}
                  </div>
                {% endif %}
                {% if profile.more_info %}
                  <div class="more-info">{{ profile.more_info }}</div>
                {% endif %}
              </div>
              <div class="clearfix member-bio">
                {% if profile.content %}
                  {% if profile.section %}
                    {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
                    {% assign lines = profile_content | split: '---' %}
                    {% for line in lines %}
                      {% if line contains profile.section %}
                        {% assign section_content = line | split: profile.section | last %}
                        {{ section_content | markdownify }}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% else %}
                    {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
                    {{ profile_content | markdownify }}
                  {% endif %}
                {% else %}
                  {{ profile.excerpt }}
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if page.current_members %}
      <h2 class="section-title">
        <span>Current Members</span>
        <small>{{ current_total }}</small>
      </h2>

      {% if page.current_members.postdoctoralresearcher %}
        <h3 class="subsection-title" id="postdoc">
          <span>Postdoctoral Researcher</span>
          <small>{{ postdoc_count }}</small>
        </h3>
        <div class="members-section member-grid">
          {% for profile in page.current_members.postdoctoralresearcher %}
            <div class="member-profile people-card">
              <div class="profile-container">
                <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
                  {% if profile.image %}
                    {% if profile.image contains 'http' %}
                      {% assign profile_image_path = profile.image %}
                    {% else %}
                      {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
                    {% endif %}
                    {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
                    {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3 }}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
                    <div class="profile-image-wrapper">
                      {% include figure.liquid path=profile_image_path class=profile_image_class sizes=sizes alt=profile.name %}
                    </div>
                    <div class="profile-info">
                      {% if profile.name %}
                        <div class="profile-name">{{ profile.name }}</div>
                      {% endif %}
                      {% if profile.role %}
                        <div class="profile-role">{{ profile.role | replace: ', ', ' &middot; ' }}</div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
                <div class="clearfix member-bio">
                  {% if profile.content and profile.section %}
                    {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
                    {% assign lines = profile_content | split: '---' %}
                    {% for line in lines %}
                      {% if line contains profile.section %}
                        {% assign section_content = line | split: profile.section | last %}
                        {{ section_content | markdownify }}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% else %}
                    {{ profile.excerpt }}
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if page.current_members.graduatestudents %}
        <h3 class="subsection-title" id="grad">
          <span>Graduate Students</span>
          <small>{{ grad_count }}</small>
        </h3>
        <div class="members-section member-grid">
          {% for profile in page.current_members.graduatestudents %}
            <div class="member-profile people-card">
              <div class="profile-container">
                <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
                  {% if profile.image %}
                    {% if profile.image contains 'http' %}
                      {% assign profile_image_path = profile.image %}
                    {% else %}
                      {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
                    {% endif %}
                    {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
                    {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3 }}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
                    <div class="profile-image-wrapper">
                      {% include figure.liquid path=profile_image_path class=profile_image_class sizes=sizes alt=profile.name %}
                    </div>
                    <div class="profile-info">
                      {% if profile.name %}
                        <div class="profile-name">{{ profile.name }}</div>
                      {% endif %}
                      {% if profile.role %}
                        <div class="profile-role">{{ profile.role | replace: ', ', ' &middot; ' }}</div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
                <div class="clearfix member-bio">
                  {% if profile.content and profile.section %}
                    {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
                    {% assign lines = profile_content | split: '---' %}
                    {% for line in lines %}
                      {% if line contains profile.section %}
                        {% assign section_content = line | split: profile.section | last %}
                        {{ section_content | markdownify }}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% else %}
                    {{ profile.excerpt }}
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if page.current_members.undergraduatestudents %}
        <h3 class="subsection-title" id="undergrad">
          <span>Undergraduate Students</span>
          <small>{{ undergrad_count }}</small>
        </h3>
        <div class="members-section member-grid">
          {% for profile in page.current_members.undergraduatestudents %}
            <div class="member-profile people-card">
              <div class="profile-container">
                <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
                  {% if profile.image %}
                    {% if profile.image contains 'http' %}
                      {% assign profile_image_path = profile.image %}
                    {% else %}
                      {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
                    {% endif %}
                    {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
                    {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3 }}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
                    <div class="profile-image-wrapper">
                      {% include figure.liquid path=profile_image_path class=profile_image_class sizes=sizes alt=profile.name %}
                    </div>
                    <div class="profile-info">
                      {% if profile.name %}
                        <div class="profile-name">{{ profile.name }}</div>
                      {% endif %}
                      {% if profile.role %}
                        <div class="profile-role">{{ profile.role | replace: ', ', ' &middot; ' }}</div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
                <div class="clearfix member-bio">
                  {% if profile.content and profile.section %}
                    {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
                    {% assign lines = profile_content | split: '---' %}
                    {% for line in lines %}
                      {% if line contains profile.section %}
                        {% assign section_content = line | split: profile.section | last %}
                        {{ section_content | markdownify }}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% else %}
                    {{ profile.excerpt }}
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if page.current_members.highschoolstudents and page.current_members.highschoolstudents.size > 0 %}
        <h3 class="subsection-title" id="highschool">
          <span>High School Students</span>
          <small>{{ highschool_count }}</small>
        </h3>
        <div class="members-section member-grid">
          {% for profile in page.current_members.highschoolstudents %}
            <div class="member-profile people-card">
              <div class="profile-container">
                <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
                  {% if profile.image %}
                    {% if profile.image contains 'http' %}
                      {% assign profile_image_path = profile.image %}
                    {% else %}
                      {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
                    {% endif %}
                    {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
                    {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3 }}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
                    <div class="profile-image-wrapper">
                      {% include figure.liquid path=profile_image_path class=profile_image_class sizes=sizes alt=profile.name %}
                    </div>
                    <div class="profile-info">
                      {% if profile.name %}
                        <div class="profile-name">{{ profile.name }}</div>
                      {% endif %}
                      {% if profile.role %}
                        <div class="profile-role">{{ profile.role | replace: ', ', ' &middot; ' }}</div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
                <div class="clearfix member-bio">
                  {% if profile.content and profile.section %}
                    {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
                    {% assign lines = profile_content | split: '---' %}
                    {% for line in lines %}
                      {% if line contains profile.section %}
                        {% assign section_content = line | split: profile.section | last %}
                        {{ section_content | markdownify }}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% else %}
                    {{ profile.excerpt }}
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    {% if page.past_members %}
      <h2 class="section-title" id="past">
        <span>Past Members</span>
        <small>{{ page.past_members | size }}</small>
      </h2>
      {% assign past_with_end = page.past_members | where_exp: 'm', 'm.end' %}
      {% assign past_without_end = page.past_members | where_exp: 'm', 'm.end == nil' %}
      {% assign past_sorted = past_with_end | sort: 'end' | reverse %}
      <div class="past-members-table">
        {% for member in past_sorted %}
          <div class="past-member-row">
            <div class="past-member-name">{{ member.name }}</div>
            <div class="past-member-affiliation">{{ member.affiliation }}</div>
            <div class="past-member-duration">
              {% if member.start %}{{ member.start }}{% endif %}
              {% if member.start and member.end %}-{% endif %}
              {% if member.end %}{{ member.end }}{% endif %}
            </div>
          </div>
        {% endfor %}
        {% for member in past_without_end %}
          <div class="past-member-row">
            <div class="past-member-name">{{ member.name }}</div>
            <div class="past-member-affiliation">{{ member.affiliation }}</div>
            <div class="past-member-duration">{% if member.start %}{{ member.start }}{% endif %}</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </article>
</div>
